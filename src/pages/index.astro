---
// Home, laid out as a test report: the name and counted results, the skills graph
// beside the rule the work follows, the project index on paper, and the tools line.
// The footer carries the email.
import Base from '../layouts/Base.astro';
import IndexRow from '../components/IndexRow.astro';
import Eyebrow from '../components/Eyebrow.astro';
import StatRail from '../components/StatRail.astro';
import EvidenceMap from '../components/EvidenceMap.astro';
import Follower from '../components/Follower.astro';
import { profile, copy, getProjects, hasPage, siteStats, inWords, pad2, fill } from '../lib/site';

const projects = await getProjects();
const shipped = projects.filter(hasPage);
const stats = siteStats(projects);
const words = profile.name.split(' ');
const count = inWords(shipped.length);

// The role line and the intro each end in the second face. Both splits are checked
// here so an edit to facts.json fails the build instead of dropping the styling.
const cut = profile.role.indexOf(', ');
if (cut < 0) throw new Error('facts.json role needs a comma before its second half');
const roleHead = profile.role.slice(0, cut + 1);
const roleTail = profile.role.slice(cut + 2);
const tailText = 'what actually happened when I tested it';
const at = profile.intro.lastIndexOf(tailText);
if (at < 0) throw new Error(`facts.json intro must end with "${tailText}"`);
const introHead = profile.intro.slice(0, at);
const introEnd = profile.intro.slice(at + tailText.length);
---

<Base
  title={`${profile.name}. ${profile.role}`}
  description="Seven projects in backend and data systems. Each one has a demo you can open and numbers copied from its own write-up."
>
  <section class="hero wrap" data-theme="field" aria-labelledby="hero-name">
    <Eyebrow text={fill(copy.eyebrows.hero, { count })} class="hero__eyebrow" />
    <h1 class="hero__name" id="hero-name">
      {
        words.map((w, i) => (
          <span class="hero__mask">
            <span class="hero__word" data-rise style={`--i:${i}`}>
              {w}
            </span>
          </span>
        ))
      }
    </h1>
    <p class="hero__role" data-settle style="--i:0">
      {roleHead} <span class="role__tail">{roleTail}</span>
    </p>
    <div class="hero__rail">
      <StatRail stats={stats} />
    </div>
  </section>

  <section class="about wrap" data-theme="field" aria-labelledby="about-h">
    <div class="about__graph" data-reveal>
      <EvidenceMap />
    </div>
    <div class="about__body" data-reveal>
      <Eyebrow as="h2" id="about-h" text={copy.eyebrows.about} />
      <p class="about__text">
        {introHead}<span class="about__tail">{tailText}</span>{introEnd}
      </p>
    </div>
  </section>

  <section class="work" id="work" data-theme="paper" aria-labelledby="work-h">
    <div class="wrap">
      <Eyebrow as="h2" id="work-h" class="work__cap" text={fill(copy.eyebrows.projects, { last: pad2(projects.length) })} />
      <ol class="work__list" data-follow-scope>
        {projects.map((p, i) => <IndexRow project={p} index={i} />)}
      </ol>
    </div>
  </section>
  <Follower projects={shipped} />

  <section class="tools wrap" data-theme="field" aria-labelledby="tools-h">
    <Eyebrow as="h2" id="tools-h" class="tools__cap" text={fill(copy.eyebrows.tools, { n: profile.skills.length, count })} />
    <p class="tools__line" data-reveal>
      {
        profile.skills.map((s, i) => (
          <>
            <span class="tools__item">{s}</span>
            {i < profile.skills.length - 1 && <span class="tools__sep" aria-hidden="true">/</span>}
          </>
        ))
      }
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-6) var(--space-7);
  }
  .hero__name {
    color: var(--hi);
    font-size: var(--step-giant);
    line-height: 0.82;
    letter-spacing: -0.015em;
    margin-left: -0.04em;
  }
  /* Each word rises out of its own mask on first paint. */
  .hero__mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.04em;
    margin-right: 0.18em;
  }
  .hero__word {
    display: inline-block;
  }
  .hero__role {
    font-size: var(--step-2);
    line-height: 1.25;
  }
  .role__tail {
    font-family: var(--font-verdict);
    font-style: italic;
    font-size: 1.08em;
  }
  .hero__rail {
    margin-top: var(--space-4);
  }

  .about {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }
  /* On a phone the skills index is long, so the paragraph comes first. */
  .about__body {
    order: -1;
    display: grid;
    gap: var(--space-4);
  }
  .about__text {
    max-width: 34ch;
    font-size: var(--step-2);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .about__tail {
    font-family: var(--font-verdict);
    font-style: italic;
    font-size: 1.08em;
    letter-spacing: 0;
    color: var(--hi);
  }

  /* The paper section. html turns paper while this crosses the middle of the screen. */
  .work {
    padding-block: var(--space-8) var(--space-9);
    scroll-margin-top: 0;
  }
  .work :global(.work__cap) {
    margin-bottom: var(--space-5);
  }

  .tools {
    padding-top: var(--space-8);
  }
  .tools :global(.tools__cap) {
    margin-bottom: var(--space-4);
  }
  .tools__line {
    max-width: 60rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .tools__item {
    white-space: nowrap;
  }
  .tools__sep {
    color: var(--cream-3);
    margin-inline: 0.35em;
  }

  @media (min-width: 60rem) {
    .hero,
    .about,
    .tools {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
    .hero {
      align-items: end;
      padding-block: var(--space-7) var(--space-8);
    }
    .hero :global(.hero__eyebrow),
    .hero__name,
    .hero__rail {
      grid-column: 1 / -1;
    }
    .hero__role {
      grid-column: 1 / 7;
    }
    .about {
      align-items: stretch;
    }
    .about__graph {
      grid-column: 1 / 6;
      grid-row: 1;
      display: grid;
    }
    .about__body {
      order: 0;
      grid-column: 6 / 13;
      grid-row: 1;
      align-content: start;
    }
    .tools :global(.tools__cap) {
      grid-column: 1 / 4;
      padding-top: 0.6em;
    }
    .tools__line {
      grid-column: 4 / 13;
    }
  }
</style>
