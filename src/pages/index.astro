---
// Home: the name in poster type, the skills graph beside a paragraph about the work,
// the eight-line project index, and the tools line. The footer carries the email.
import Base from '../layouts/Base.astro';
import IndexRow from '../components/IndexRow.astro';
import EvidenceMap from '../components/EvidenceMap.astro';
import { profile, getProjects } from '../lib/site';

const projects = await getProjects();
const words = profile.name.split(' ');
---

<Base
  title={`${profile.name}. ${profile.role}`}
  description="Eight projects in backend, data and LLM systems, each with a live demo and numbers copied from its own results files."
>
  <section class="hero wrap" aria-labelledby="hero-name">
    <h1 class="hero__name" id="hero-name">
      {
        words.map((w, i) => (
          <span class="hero__mask">
            <span class="hero__word" data-rise style={`--i:${i}`}>
              {w}
            </span>
          </span>
        ))
      }
    </h1>
    <p class="hero__role" data-settle style="--i:0">{profile.role}</p>
  </section>

  <section class="about wrap" aria-label="About">
    <div class="about__graph" data-settle style="--i:2">
      <EvidenceMap />
    </div>
    <p class="about__text" data-settle style="--i:1">{profile.intro}</p>
  </section>

  <section class="work wrap" id="work" aria-labelledby="work-h">
    <div class="work__head">
      <h2 id="work-h" class="work__title">Projects</h2>
      <p class="label work__note">Ordered by what I would show first. Each opens its demo, GIF and numbers.</p>
    </div>
    <ol class="work__list">
      {projects.map((p, i) => <IndexRow project={p} index={i} />)}
    </ol>
  </section>

  <section class="tools wrap" aria-labelledby="tools-h">
    <h2 id="tools-h" class="label tools__cap">Tools I use in these projects</h2>
    <p class="tools__line">
      {
        profile.skills.map((s, i) => (
          <>
            <span class="tools__item">{s}</span>
            {i < profile.skills.length - 1 && <span class="tools__sep" aria-hidden="true">/</span>}
          </>
        ))
      }
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7) var(--space-6);
  }
  .hero__name {
    color: var(--name);
    font-size: var(--step-giant);
    line-height: 0.82;
    letter-spacing: -0.015em;
    margin-left: -0.04em;
  }
  /* Each word rises out of its own mask on first paint. */
  .hero__mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.04em;
    margin-right: 0.18em;
  }
  .hero__word {
    display: inline-block;
  }
  .hero__role {
    font-size: var(--step-1);
    color: var(--cream-2);
  }

  .about {
    display: grid;
    gap: var(--space-6);
  }
  .about__text {
    max-width: 34ch;
    font-size: var(--step-2);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .work {
    margin-top: var(--space-9);
    scroll-margin-top: var(--space-5);
  }
  .work__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .work__title {
    font-size: var(--step-3);
  }
  .work__note {
    max-width: 44ch;
    color: var(--cream-2);
  }

  .tools {
    margin-top: var(--space-9);
  }
  .tools__cap {
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: none;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--cream-2);
    margin-bottom: var(--space-4);
  }
  .tools__line {
    max-width: 60rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .tools__item {
    white-space: nowrap;
  }
  .tools__sep {
    color: var(--cream-3);
    margin-inline: 0.35em;
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
      padding-block: var(--space-8) var(--space-7);
    }
    .hero__name {
      grid-column: 1 / -1;
    }
    .hero__role {
      grid-column: 1 / 6;
    }
    /* Offset to the right so the page reads as a poster, not a centred column. */
    .about {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
      align-items: stretch;
    }
    .about__graph {
      grid-column: 1 / 6;
      grid-row: 1;
      display: grid;
    }
    .about__text {
      grid-column: 6 / 13;
      grid-row: 1;
    }
    .work__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .work__title {
      grid-column: 1 / 6;
    }
    .work__note {
      grid-column: 6 / 11;
    }
    .tools {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .tools__cap {
      grid-column: 1 / 4;
      padding-top: 0.6em;
    }
    .tools__line {
      grid-column: 4 / 13;
    }
  }
</style>
