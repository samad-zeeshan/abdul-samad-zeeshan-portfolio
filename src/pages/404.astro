---
// Not-found page. Astro emits it as 404.html, which GitHub Pages serves for unknown URLs.
import Base from '../layouts/Base.astro';
import { profile } from '../lib/site';
import { withBase } from '../lib/paths';
---

<Base title={`Page not found. ${profile.name}`} description="This page does not exist.">
  <section class="lost wrap">
    <h1 class="lost__title">Not here</h1>
    <p class="lost__msg">This address has no page. The projects are all on the home page.</p>
    <a class="btn btn--solid" href={withBase('/#work')}>
      See the projects <span class="btn__arrow" aria-hidden="true">&#8599;</span>
    </a>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-block: var(--space-8) var(--space-6);
  }
  .lost__title {
    font-size: var(--step-giant);
  }
  .lost__msg {
    font-size: var(--step-1);
    max-width: 40ch;
  }
</style>
