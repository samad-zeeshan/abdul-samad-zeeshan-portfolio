---
// Page shell: head meta, the hairline columns, header, email pill and footer, and the
// small scripts for the entrance, count-up, section reveals and theme flips.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Smoke from '../components/Smoke.astro';
import { profile, copy } from '../lib/site';
import { withBase } from '../lib/paths';
import displayFont from '../assets/fonts/BigShouldersDisplay-var.woff2?url';
import textFont from '../assets/fonts/SchibstedGrotesk-var.woff2?url';
import verdictFont from '../assets/fonts/InstrumentSerif-italic.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  current?: string;
  tone?: { scheme: 'light' | 'dark'; bg: string; ink: string; ink2: string; accent: string; line: string };
}

const { title, description, image = '/og/home.png', current, tone } = Astro.props;
// A project page paints itself in its demo's palette by overriding the tone tokens.
// Verdicts follow the site rule, accent on a dark page and ink on a light one.
const toneStyle = tone
  ? [
      `--tone-bg:${tone.bg}`,
      `--tone-ink:${tone.ink}`,
      `--tone-ink-2:${tone.ink2}`,
      `--tone-accent:${tone.accent}`,
      `--tone-line:${tone.line}`,
      `--hi:${tone.scheme === 'dark' ? tone.accent : tone.ink}`,
      `--hair:color-mix(in srgb, ${tone.ink} ${tone.scheme === 'dark' ? 5 : 7}%, transparent)`,
      `--pill-bg:${tone.accent}`,
      `--pill-ink:${tone.bg}`,
      `color-scheme:${tone.scheme}`,
    ].join(';')
  : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase(image), Astro.site).href;
---

<!doctype html>
<html lang="en" style={toneStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* The new page is shown at its first paint, which can come before the parser reaches
        the heading. Holding that paint for the heading keeps the name morph from dropping. */}
    {current && <link rel="expect" href="#project-name" blocking="render" />}
    <script is:inline define:vars={{ fonts: [displayFont, textFont, verdictFont] }}>
      // Preload the fonts on the first page of a visit only. On later pages Chrome serves
      // them from memory, never claims the preload, and warns that it went unused.
      var later = false;
      try {
        later = !!sessionStorage.getItem('seen');
      } catch (e) {}
      if (!later) fonts.forEach(function (href) {
        var l = document.createElement('link');
        l.rel = 'preload';
        l.as = 'font';
        l.type = 'font/woff2';
        l.crossOrigin = 'anonymous';
        l.href = href;
        document.head.appendChild(l);
      });
    </script>
    <meta name="theme-color" content={tone ? tone.bg : '#121214'} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // The entrance plays on the first page of a visit only. Later navigations and
      // reduced-motion users get the settled page straight away.
      (function () {
        document.documentElement.classList.add('js');
        try {
          if (sessionStorage.getItem('seen')) return;
          sessionStorage.setItem('seen', '1');
        } catch (e) {}
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('enter');
      })();
    </script>
  </head>
  <body>
    <Smoke />
    <div class="progress" aria-hidden="true"></div>
    <div class="hair" aria-hidden="true">
      <div class="wrap hair__grid">
        {Array.from({ length: 12 }, (_, i) => <span style={`--n:${i}`} />)}
      </div>
    </div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <a class="pill" href={`mailto:${profile.email}`} data-magnetic>
      <span class="mag">
        <svg class="pill__icon" viewBox="0 0 16 12" width="16" height="12" aria-hidden="true">
          <path d="M1 1h14v10H1zM1 1l7 5.5L15 1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
        </svg>
        <span class="pill__long">{copy.pill.long}</span>
        <span class="pill__short">{copy.pill.short}</span>
      </span>
      <span class="fill" aria-hidden="true"></span>
    </a>
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Magnetic pills lean toward the pointer. Strength is 0.4 because the email pill
      // sits in a corner and a full-strength pull drags it off the screen.
      (function () {
        if (!matchMedia('(pointer: fine)').matches) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll('[data-magnetic]').forEach(function (el) {
          var inner = el.firstElementChild;
          var tx = 0, ty = 0;
          el.addEventListener('mousemove', function (e) {
            // The rect already includes the pull, so take it back out to find the
            // resting centre. Otherwise the pull feeds on itself and comes out weaker.
            var r = el.getBoundingClientRect();
            var dx = e.clientX - (r.left - tx + r.width / 2);
            var dy = e.clientY - (r.top - ty + r.height / 2);
            tx = dx * 0.4;
            ty = dy * 0.4;
            el.classList.add('is-live');
            el.style.transform = 'translate(' + tx + 'px,' + ty + 'px)';
            if (inner) inner.style.transform = 'translate(' + dx * 0.2 + 'px,' + dy * 0.2 + 'px)';
          });
          el.addEventListener('mouseleave', function () {
            tx = ty = 0;
            el.classList.remove('is-live');
            el.style.transform = '';
            if (inner) inner.style.transform = '';
          });
        });
      })();
    </script>
    <script is:inline>
      // Headline numbers count up from zero the first time half of one is on screen.
      // The screen-reader copy beside each one always holds the real value, and the
      // count ends on the exact rendered text, which the built-page check reads.
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;
        // A leading number with its separators and decimals, then whatever follows,
        // such as " of 84" or " to 0.607". Only the leading number counts.
        var LEAD = /^(\d[\d,]*(?:\.\d+)?)([\s\S]*)$/;
        var jobs = new Map();
        document.querySelectorAll('[data-count]').forEach(function (el) {
          var raw = el.textContent;
          var m = LEAD.exec(raw.trim());
          if (!m) return;
          var end = parseFloat(m[1].replace(/,/g, ''));
          if (!(end > 0)) return;
          var decimals = (m[1].split('.')[1] || '').length;
          var opts = {
            minimumFractionDigits: decimals,
            maximumFractionDigits: decimals,
            useGrouping: m[1].indexOf(',') >= 0,
          };
          var fmt = function (v) { return v.toLocaleString('en-US', opts) + m[2]; };
          // Reserve the final width so the counting digits never reflow the line.
          el.style.display = 'inline-block';
          el.style.minWidth = raw.trim().length + 'ch';
          el.textContent = fmt(0);
          jobs.set(el, { raw: raw, end: end, fmt: fmt });
        });
        if (!jobs.size) return;
        // On the first visit the rail is still settling, so its count waits for it.
        var lag = document.documentElement.classList.contains('enter') ? 200 : 0;
        var io = new IntersectionObserver(
          function (entries) {
            var k = 0;
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              io.unobserve(e.target);
              var el = e.target, job = jobs.get(el);
              var start = performance.now() + lag + k++ * 60;
              function tick(now) {
                var t = Math.min(1, Math.max(0, (now - start) / 900));
                // Same critically damped curve as the card settle, so the two finish together.
                var w = 9.2 * t;
                var p = t >= 1 ? 1 : 1 - (1 + w) * Math.exp(-w);
                if (t < 1) {
                  el.textContent = job.fmt(job.end * p);
                  return requestAnimationFrame(tick);
                }
                el.textContent = job.raw;
                el.style.display = el.style.minWidth = '';
              }
              requestAnimationFrame(tick);
            });
          },
          { threshold: 0.5 },
        );
        jobs.forEach(function (_, el) { io.observe(el); });
      })();
    </script>
    <script is:inline>
      // Sections fade up once when 15 percent is on screen. Reduced motion never hides
      // them in the first place, see global.css.
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          },
          { threshold: 0.15 },
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    <script is:inline>
      // Short labels decode: each letter flickers through random glyphs, then lands on
      // its real character, left to right. The real text is in the HTML throughout.
      (function () {
        if (!matchMedia('(hover: hover) and (pointer: fine) and (min-width: 60rem) and (prefers-reduced-motion: no-preference)').matches) return;
        var GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/';
        function decode(el, delay) {
          var text = el.textContent;
          var n = text.replace(/\s/g, '').length;
          // 25ms a letter, squeezed on long lines so every line lands inside 900ms.
          var step = n > 1 ? Math.min(25, 650 / (n - 1)) : 0;
          var k = 0;
          var ends = text.split('').map(function (c) {
            return /\s/.test(c) ? -1 : delay + 250 + step * k++;
          });
          // Random capitals are wider than the real letters in the text face, so an
          // inline label is pinned and clipped to its width until it lands. Otherwise
          // the line reflows or the glyphs run into the next words.
          var inline = getComputedStyle(el).display === 'inline';
          if (inline) {
            el.style.display = 'inline-block';
            el.style.width = el.getBoundingClientRect().width + 'px';
            el.style.whiteSpace = 'nowrap';
            el.style.clipPath = 'inset(-0.5em 0 -0.5em 0)';
          }
          var start = performance.now(), last = -1e9;
          function frame(now) {
            var t = now - start, done = true;
            // New glyphs every 40ms. At 60 a second the flicker is too fast to read as letters.
            if (now - last >= 40) {
              last = now;
              el.textContent = ends.map(function (end, i) {
                if (end < 0 || t >= end) return text[i];
                done = false;
                return GLYPHS[(Math.random() * GLYPHS.length) | 0];
              }).join('');
            } else done = false;
            if (!done) return requestAnimationFrame(frame);
            el.textContent = text;
            if (inline) el.removeAttribute('style');
          }
          requestAnimationFrame(frame);
        }
        // The role line starts scrambled and lands once the name has risen, about
        // 700ms into the first visit. Later pages decode it straight away.
        var first = document.documentElement.classList.contains('enter');
        document.querySelectorAll('[data-decode="paint"]').forEach(function (el) {
          decode(el, first ? 700 : 0);
        });
        var els = document.querySelectorAll('[data-decode]:not([data-decode="paint"])');
        if (!('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              io.unobserve(e.target);
              decode(e.target, 0);
            });
          },
          { threshold: 0.5 },
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    <script>
      // Smooth wheel scrolling on wide pointer screens. The import sits behind the same
      // gate, so phones, touch and reduced-motion visitors never download the library.
      const smooth = '(pointer: fine) and (min-width: 60rem) and (prefers-reduced-motion: no-preference)';
      if (matchMedia(smooth).matches) {
        import('lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1, smoothWheel: true, syncTouch: false });
          const loop = (t: number) => {
            lenis.raf(t);
            requestAnimationFrame(loop);
          };
          requestAnimationFrame(loop);

          // The header slides away on the way down and comes back on the way up.
          // Near the top it always shows, and it only takes a fill once the page moves.
          const head = document.querySelector<HTMLElement>('.head');
          if (head) {
            lenis.on('scroll', ({ scroll, direction }: { scroll: number; direction: number }) => {
              head.classList.toggle('is-stuck', scroll > 0);
              if (scroll <= 160 || direction === -1) head.classList.remove('is-away');
              else if (direction === 1) head.classList.add('is-away');
            });
          }

          // Same-page anchors go through Lenis, or the native jump cuts across its easing.
          document.addEventListener('click', (e) => {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
            if (!a || a.origin !== location.origin || a.pathname !== location.pathname || !a.hash) return;
            const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
            if (!target) return;
            e.preventDefault();
            lenis.scrollTo(a.hash, { offset: 0 });
            history.pushState(null, '', a.hash);
            // A native anchor jump also moves focus. Without this the skip link would
            // scroll but leave the next Tab on the header.
            if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
            target.focus({ preventScroll: true });
          });

          // Stopped while the view transition snapshots the old page, and started again
          // if the page comes back from the back-forward cache.
          addEventListener('pagehide', () => lenis.stop());
          addEventListener('pageshow', () => lenis.start());
        });
      }
    </script>
    <script is:inline>
      // Theme flip. The margins shrink the viewport to a line across its middle, so
      // whichever section crosses that line owns the page colour. html carries the
      // colour and transitions it, so every section and the header follow.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var root = document.documentElement;
        var els = [].slice.call(document.querySelectorAll('body [data-theme]'));
        var on = new Set();
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) on.add(e.target);
              else on.delete(e.target);
            });
            // The about section sticks, so it stays on the line under the sheet that
            // covers it. Later sections stack on top, so the last one on the line wins.
            for (var i = els.length - 1; i >= 0; i--) {
              if (on.has(els[i])) return root.setAttribute('data-theme', els[i].getAttribute('data-theme'));
            }
          },
          { rootMargin: '-50% 0px -50% 0px' },
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
