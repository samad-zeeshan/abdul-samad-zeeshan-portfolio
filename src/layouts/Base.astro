---
// Page shell: head meta for search and share cards, the header and footer, and the
// one-time entrance and count-up script.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../lib/site';
import { withBase } from '../lib/paths';
import displayFont from '../assets/fonts/BigShouldersDisplay-var.woff2?url';
import textFont from '../assets/fonts/SchibstedGrotesk-var.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  current?: string;
  tone?: { scheme: 'light' | 'dark'; bg: string; ink: string; ink2: string; accent: string; line: string };
}

const { title, description, image = '/og/home.png', current, tone } = Astro.props;
// A project page paints itself in its demo's palette by overriding the tone tokens.
const toneStyle = tone
  ? `--tone-bg:${tone.bg};--tone-ink:${tone.ink};--tone-ink-2:${tone.ink2};--tone-accent:${tone.accent};--tone-line:${tone.line};color-scheme:${tone.scheme}`
  : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase(image), Astro.site).href;
---

<!doctype html>
<html lang="en" style={toneStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content={tone ? tone.bg : '#1f2ee8'} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // The entrance plays on the first page of a visit only. Later navigations and
      // reduced-motion users get the settled page straight away.
      (function () {
        try {
          if (sessionStorage.getItem('seen')) return;
          sessionStorage.setItem('seen', '1');
        } catch (e) {}
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('enter');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Headline numbers count up once, alongside the entrance. The final value is in
      // the HTML, so screen readers and no-JS visitors always get the real number.
      (function () {
        if (!document.documentElement.classList.contains('enter')) return;
        var els = document.querySelectorAll('[data-count]');
        els.forEach(function (el, i) {
          var target = el.getAttribute('data-count');
          var decimals = (target.split('.')[1] || '').length;
          var end = parseFloat(target.replace(/,/g, ''));
          var fmt = function (v) {
            return v.toLocaleString('en-US', {
              minimumFractionDigits: decimals,
              maximumFractionDigits: decimals,
            });
          };
          // Reserve the final width so the counting digits never reflow the line.
          el.style.display = 'inline-block';
          el.style.minWidth = target.length + 'ch';
          var start = performance.now() + 200 + i * 60;
          var dur = 900;
          el.textContent = fmt(0);
          function tick(now) {
            var t = Math.min(1, Math.max(0, (now - start) / dur));
            // Same critically damped curve as the card settle, so the two finish together.
            var w = 9.2 * t;
            var p = t >= 1 ? 1 : 1 - (1 + w) * Math.exp(-w);
            el.textContent = fmt(end * p);
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = target;
          }
          requestAnimationFrame(tick);
        });
      })();
    </script>
  </body>
</html>
