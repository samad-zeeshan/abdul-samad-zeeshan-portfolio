---
// Site header, always on the field colour so project pages sit inside the system.
import { profile } from '../lib/site';
import { withBase } from '../lib/paths';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const onHome = current === undefined;
---

<header class="head">
  <div class="wrap head__inner">
    <a class="head__name" href={withBase('/')} aria-current={onHome ? 'page' : undefined}>
      {profile.name}
    </a>
    <nav class="head__nav" aria-label="Primary">
      <a href={withBase('/#work')}>Projects</a>
      <a href={profile.github} rel="noopener">GitHub</a>
      <a href={`mailto:${profile.email}`}>Email</a>
    </nav>
  </div>
</header>

<style>
  .head {
    background: var(--field);
    color: var(--cream);
    border-bottom: 1px solid var(--line);
  }
  .head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    min-height: 3.75rem;
    padding-block: var(--space-2);
  }
  .head__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .head__nav {
    display: flex;
    gap: var(--space-5);
    font-size: var(--step--1);
  }
  .head__nav a {
    display: inline-block;
    padding-block: var(--space-2);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size var(--dur-hover) var(--ease-out);
  }
  .head__nav a:hover,
  .head__nav a:focus-visible {
    background-size: 100% 1px;
  }
  .head :focus-visible {
    outline-color: var(--cream);
  }
</style>
