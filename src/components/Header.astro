---
// Site header with no fill of its own, so it takes the colour of whatever theme the page is in.
import { profile } from '../lib/site';
import { withBase } from '../lib/paths';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const onHome = current === undefined;
---

<header class="head">
  <div class="wrap head__inner">
    <a class="head__name" href={withBase('/')} aria-current={onHome ? 'page' : undefined}>
      {profile.name}
    </a>
    <nav class="head__nav" aria-label="Primary">
      <a class="dot" href={withBase('/#work')}>Projects</a>
      <a class="dot" href={withBase('/resume.pdf')} type="application/pdf">Resume</a>
      <a class="dot" href={profile.github} rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .head {
    position: relative;
    z-index: var(--z-header);
  }
  /* The right padding keeps the links clear of the fixed email pill. */
  .head__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    min-height: 5rem;
    padding-block: var(--space-4) var(--space-2);
    padding-right: calc(var(--gutter) + 6.5rem);
  }
  .head__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .head__nav {
    display: flex;
    gap: var(--space-5);
    font-size: var(--step--1);
  }
  .head__nav a {
    display: inline-block;
    padding-block: var(--space-2);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size var(--dur-hover) var(--ease-out);
  }
  .head__nav a:hover,
  .head__nav a:focus-visible {
    background-size: 100% 1px;
  }
  /* With smooth scrolling on, the header sticks so it can slide away and back. It
     takes the page colour as a fill once scrolled, or links would sit on top of text. */
  :global(html.lenis) .head {
    position: sticky;
    top: 0;
    transition:
      transform 0.4s var(--ease-out),
      background-color var(--dur-theme) ease;
  }
  :global(html.lenis) .head.is-stuck {
    background: var(--tone-bg);
  }
  :global(html.lenis) .head.is-away:not(:focus-within) {
    transform: translateY(-100%);
  }
  @media (min-width: 60rem) {
    .head__inner {
      padding-right: calc(var(--gutter) + 9rem);
    }
  }
</style>
