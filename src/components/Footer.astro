---
// Footer on the field: the email as the last big line, then one line pointing to GitHub.
import { profile } from '../lib/site';

// Fixed rather than new Date(), so a rebuild in a later year does not change the page.
const year = '2026';
---

<footer class="foot" id="contact">
  <div class="wrap">
    <a class="foot__email" href={`mailto:${profile.email}`} aria-label={`Email ${profile.email}`}>{profile.email}</a>
    <div class="foot__meta">
      <p>
        Everything else I have built is on <a class="link" href={profile.github} rel="noopener">GitHub</a>.
      </p>
      <p>{profile.name}, {year}</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--space-9);
    padding-block: var(--space-8) var(--space-6);
    /* Room for the fixed palette picker, so it never covers the last line. */
    padding-bottom: calc(var(--space-6) + 3.5rem);
    background: var(--field);
    color: var(--cream);
    --tone-accent: var(--cream);
    --tone-ink-2: var(--cream-2);
  }
  .foot :focus-visible {
    outline-color: var(--cream);
  }
  .foot__email {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 0.2rem + 8.4vw, 9rem);
    line-height: 0.9;
    text-transform: uppercase;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 0.06em;
    padding-bottom: 0.08em;
    transition: background-size var(--dur-hover) var(--ease-out);
  }
  .foot__email:hover,
  .foot__email:focus-visible {
    background-size: 100% 0.06em;
  }
  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--cream-2);
  }
</style>
