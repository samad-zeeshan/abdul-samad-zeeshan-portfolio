---
// Footer as an accent card: the email as the last big line, a numbered nav, and
// where the numbers come from.
import { profile, copy, pad2 } from '../lib/site';
import { withBase } from '../lib/paths';

// Fixed rather than new Date(), so a rebuild in a later year does not change the page.
const year = '2026';
const hrefs = [withBase('/#work'), withBase('/resume.pdf'), profile.github];
const links = copy.footer.nav.map((label, i) => ({ label, href: hrefs[i], n: pad2(i + 1) }));
---

<footer class="foot" id="contact" data-theme="accent">
  <div class="wrap">
    <div class="foot__card" data-reveal>
      <a class="foot__email" href={`mailto:${profile.email}`} aria-label={`Email ${profile.email}`}>{profile.email}</a>
      <nav class="foot__nav" aria-label="Footer">
        <ol>
          {
            links.map((l) => (
              <li>
                <a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined} data-magnetic>
                  <span class="mag">
                    <span class="foot__n" aria-hidden="true">{l.n}</span> <span data-decode>{l.label}</span>
                  </span>
                  <span class="fill" aria-hidden="true"></span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="foot__base">
        <p>{profile.name}, {year}</p>
        <p>{copy.footer.note}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--space-9);
    padding-bottom: var(--gutter);
  }
  .foot__card {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-7) var(--space-5) var(--space-5);
    border-radius: 12px;
    container-type: inline-size;
    background: var(--accent);
    color: var(--field);
  }
  .foot :focus-visible {
    outline-color: var(--field);
  }
  .foot__email {
    display: inline-block;
    width: fit-content;
    font-family: var(--font-display);
    font-weight: 800;
    /* The address is about ten em wide in this face, so a tenth of the card keeps it
       on one line at any width instead of breaking mid-word on phones. */
    font-size: min(9rem, 100cqi / 10.5);
    line-height: 0.9;
    text-transform: uppercase;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 0.06em;
    padding-bottom: 0.08em;
    transition: background-size var(--dur-hover) var(--ease-out);
  }
  .foot__email:hover,
  .foot__email:focus-visible {
    background-size: 100% 0.06em;
  }
  .foot__nav ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--step-0);
  }
  /* Pill shaped so the rising fill has an edge to fill up to. */
  .foot__nav a {
    display: inline-flex;
    gap: 0.5em;
    padding: var(--space-2) var(--space-4);
    margin-inline: calc(var(--space-4) * -1);
    border-radius: 999px;
    text-decoration: none;
  }
  .foot__nav a:hover,
  .foot__nav a:focus-visible {
    color: var(--accent);
  }
  .foot__nav .fill {
    background: var(--field);
  }
  .foot__n {
    opacity: 0.6;
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(14, 16, 10, 0.25);
    font-size: var(--step--1);
  }
  @media (min-width: 60rem) {
    .foot__card {
      padding: var(--space-8) var(--space-7) var(--space-6);
    }
  }
  /* The card drops in with a slight tilt on wide pointer screens. Everywhere else it
     opts out of the section fade and is simply there. */
  @media (hover: hover) and (pointer: fine) and (min-width: 60rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .foot__card {
      transition:
        opacity 0.8s var(--spring),
        transform 0.8s var(--spring);
    }
    :global(html.js) .foot__card:not(.is-in) {
      transform: translateY(48px) rotate(0.4deg);
    }
  }
  @media not all and (hover: hover) and (pointer: fine) and (min-width: 60rem) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .foot__card:not(.is-in) {
      opacity: 1;
      transform: none;
    }
  }
</style>
