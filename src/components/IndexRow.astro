---
// One line of the project index: its number, the name in poster type, what it does,
// and the lead result with its verdict. The home page's follower shows the demo still.
import type { Project } from '../lib/site';
import { hasPage, countTarget, pad2 } from '../lib/site';
import { withBase } from '../lib/paths';

interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
const d = project.data;
const linked = hasPage(project);
const lead = d.numbers[0];
const Tag = linked ? 'a' : 'div';
---

<li class="row" data-settle style={`--i:${index}`}>
  <Tag
    class:list={['row__hit', { 'row__hit--static': !linked }]}
    href={linked ? withBase(`/projects/${project.id}/`) : undefined}
    data-follow={linked ? project.id : undefined}
  >
    <span class="row__index mono" aria-hidden="true">{pad2(index + 1)}</span>
    <h3 class="row__name" translate="no" style={`view-transition-name: name-${project.id}`}>{d.title}</h3>
    <p class="row__problem">{d.problem}</p>
    {
      lead ? (
        <p class="row__num">
          <span class="row__label">{lead.label}</span>
          <span class="row__figure">
            <span class="row__value mono" style={`--len:${lead.value.length}`}>
              <span class="visually-hidden">{lead.value}</span>
              <span aria-hidden="true" data-count={countTarget(lead.value)}>
                {lead.value}
              </span>
            </span>
            {lead.verdict && <span class="verdict row__verdict">{lead.verdict}</span>}
          </span>
        </p>
      ) : (
        <p class="row__num">
          <span class="row__label">No demo or numbers yet.</span>
          <span class="row__value mono">In progress</span>
        </p>
      )
    }
  </Tag>
</li>

<style>
  .row {
    border-top: 1px solid var(--tone-line);
  }
  .row:last-child {
    border-bottom: 1px solid var(--tone-line);
  }
  .row__hit {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-6);
    padding-inline: var(--space-2);
    margin-inline: calc(var(--space-2) * -1);
    text-decoration: none;
    color: var(--tone-ink);
    transition: opacity 0.4s var(--ease-out);
  }
  .row__index {
    font-size: var(--step-1);
    opacity: 0.6;
  }
  .row__name {
    font-size: var(--step-index);
    font-weight: 800;
    line-height: 0.84;
    transform-origin: left center;
    transition: transform 0.4s var(--ease-out);
    width: fit-content;
  }
  .row__problem {
    max-width: 40ch;
    font-size: var(--step-1);
    line-height: 1.4;
    transition: transform 0.4s var(--ease-out);
  }
  .row__num {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    container-type: inline-size;
    transition: opacity var(--dur-hover) var(--ease-out);
  }
  .row__label {
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--tone-ink-2);
    max-width: 34ch;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .row__figure {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
  }
  /* Long values like "1.301 to 0.607" shrink to their column instead of spilling out.
     JetBrains Mono glyphs are 0.6em wide, which is where the divisor comes from. */
  .row__value {
    color: var(--hi);
    font-size: min(var(--step-3), 100cqi / (var(--len) * 0.6));
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .row__verdict {
    font-size: var(--step-2);
    line-height: 1;
    transition: color var(--dur-hover) var(--ease-out);
  }

  @media (min-width: 60rem) {
    /* Twelve columns with the same gap as the hairlines, so each part starts on a line. */
    .row__hit {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
      align-items: end;
      padding-block: var(--space-5);
      padding-inline: 0;
      margin-inline: 0;
    }
    .row__index {
      grid-column: 1 / 2;
      align-self: start;
      padding-top: 0.3em;
    }
    .row__name {
      grid-column: 2 / 7;
    }
    .row__problem {
      grid-column: 7 / 10;
      padding-bottom: 0.35em;
    }
    .row__num {
      grid-column: 10 / 13;
      padding-bottom: 0.35em;
    }
  }

  /* The list dims and the hovered row stays lit, so the eye lands on one project while
     the follower carries its still. Touch keeps every row at full strength. */
  @media (hover: hover) and (pointer: fine) {
    :global(.work__list:hover) .row__hit {
      opacity: 0.33;
    }
    :global(.work__list) .row__hit:hover {
      opacity: 1;
    }
    .row__hit:not(.row__hit--static):hover .row__name {
      transform: translateX(-0.1em);
    }
    .row__hit:not(.row__hit--static):hover .row__problem {
      transform: translateX(0.1em);
    }
    .row__hit:not(.row__hit--static):hover:active .row__name {
      transform: translateX(-0.1em) scale(0.985);
    }
  }
  .row__hit:not(.row__hit--static):active .row__name {
    transform: scale(0.985);
  }
  /* Backwards fill only, so no clip stays on the name once it has landed. */
  @media (hover: hover) and (pointer: fine) and (min-width: 60rem) and (prefers-reduced-motion: no-preference) {
    :global(html.enter) .row__name {
      animation: name-wipe 0.6s var(--ease-out) backwards;
      animation-delay: calc(var(--i, 0) * 40ms + 260ms);
    }
  }
  @keyframes name-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }
  /* Where scroll timelines exist, the row settles as it enters and unwinds if you scroll
     back. The name wipe above only ran off screen here, so this replaces it. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .row {
        position: relative;
        view-timeline: --row block;
        border-top: 0;
      }
      .row:first-child {
        border-top: 1px solid var(--tone-line);
      }
      .row:last-child {
        border-bottom: 0;
      }
      .row::after {
        content: '';
        position: absolute;
        inset: auto 0 0;
        height: 1px;
        background: var(--tone-line);
        transform-origin: left;
        animation-name: line-draw;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --row;
        animation-range: entry 10% entry 60%;
      }
      /* html.js lifts this to the weight of the wipe rule so it wins on the first visit. */
      :global(html.js) .row__index,
      :global(html.js) .row__name,
      :global(html.js) .row__problem {
        animation-name: scroll-rise;
        animation-duration: auto;
        animation-delay: 0s;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --row;
        animation-range: entry 0% entry 40%;
      }
    }
  }
  .row__hit:focus-visible {
    outline: 2px solid var(--tone-ink);
    outline-offset: 2px;
  }
  .row__hit--static {
    color: var(--tone-ink-2);
  }
</style>
