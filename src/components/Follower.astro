---
// A poster frame and an "Open" disc that trail the pointer over a list of project links.
//
// Links opt in with data-follow="<project id>" inside a [data-follow-scope] element.
import type { Project } from '../lib/site';
import { copy } from '../lib/site';
import { withBase } from '../lib/paths';

interface Props {
  projects?: Project[];
  discOnly?: boolean;
}
const { projects = [], discOnly = false } = Astro.props;
const posters = discOnly ? [] : projects.filter((p) => p.data.poster);
---

<div class:list={['follow', { 'follow--big': discOnly }]} aria-hidden="true">
  {
    !discOnly && (
      <div class="follow__frame">
        <div class="follow__stack" style={`--n:${posters.length}`}>
          {posters.map((p) => (
            <img
              class="follow__img"
              data-id={p.id}
              data-src={withBase(`/posters/${p.data.poster}`)}
              alt=""
              width="1600"
              height="1000"
              decoding="async"
            />
          ))}
        </div>
      </div>
    )
  }
  <div class="follow__disc"><span>{copy.follower.disc}</span></div>
</div>

<script is:inline>
  (function () {
    if (!matchMedia('(pointer: fine) and (min-width: 60rem)').matches) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var root = document.currentScript.previousElementSibling;
    var frame = root.querySelector('.follow__frame');
    var stack = root.querySelector('.follow__stack');
    var disc = root.querySelector('.follow__disc');
    var parts = frame ? [frame, disc] : [disc];
    var ids = [].map.call(root.querySelectorAll('.follow__img'), function (img) {
      return img.dataset.id;
    });
    var scopes = document.querySelectorAll('[data-follow-scope]');
    if (!scopes.length) return;

    // The frame is fixed at the top left corner, so lazy loading would count it as on
    // screen and fetch every poster at page load. They load on the first hover instead.
    var loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      // Decoding all of them now, off the main thread, keeps the first switch to a
      // new poster from stalling on a decode mid-slide.
      [].forEach.call(root.querySelectorAll('.follow__img'), function (img) {
        img.src = img.dataset.src;
        img.decode().catch(function () {});
      });
    }

    // Frame lags more than the disc, which is what makes the two read as separate
    // objects instead of one sticker. The lag is a time constant in ms, not a fraction per
    // frame, so the trail feels the same on a 60 Hz and a 144 Hz screen.
    var FRAME_MS = 150, DISC_MS = 80;
    var px = 0, py = 0;
    var f = { x: 0, y: 0 }, d = { x: 0, y: 0 };
    var raf = 0, last = 0, active = false, hidden = true, current = -1, leave = 0;

    function place(el, p) {
      el.style.translate = p.x + 'px ' + p.y + 'px';
    }
    function tick(now) {
      // Capped so a frame after a stall does not jump the whole distance.
      var dt = last ? Math.min(now - last, 50) : 16.7;
      last = now;
      var kf = 1 - Math.exp(-dt / FRAME_MS), kd = 1 - Math.exp(-dt / DISC_MS);
      f.x += (px - f.x) * kf;
      f.y += (py - f.y) * kf;
      d.x += (px - d.x) * kd;
      d.y += (py - d.y) * kd;
      if (frame) place(frame, f);
      place(disc, d);
      // Both have caught up, so stop until the pointer moves again.
      if (Math.abs(px - f.x) + Math.abs(py - f.y) + Math.abs(px - d.x) + Math.abs(py - d.y) < 0.2) {
        raf = last = 0;
        return;
      }
      raf = requestAnimationFrame(tick);
    }
    function run() {
      if (!raf) raf = requestAnimationFrame(tick);
    }
    function on(i) {
      clearTimeout(leave);
      if (i !== current && stack && i >= 0) {
        stack.style.setProperty('--i', i);
        current = i;
      }
      if (active) return;
      // Coming back from fully shrunk, start under the pointer so nothing flies in from a corner.
      if (hidden) {
        f.x = d.x = px;
        f.y = d.y = py;
        hidden = false;
      }
      run();
      active = true;
      parts.forEach(function (el) { el.classList.add('active'); });
    }
    function off() {
      clearTimeout(leave);
      if (!active) return;
      active = false;
      parts.forEach(function (el) { el.classList.remove('active', 'pressed'); });
    }

    addEventListener('mousemove', function (e) {
      px = e.clientX;
      py = e.clientY;
      if (!hidden) run();
    }, { passive: true });
    disc.addEventListener('transitionend', function (e) {
      if (e.propertyName === 'scale' && !active) {
        hidden = true;
        cancelAnimationFrame(raf);
        raf = last = 0;
      }
    });
    [].forEach.call(scopes, function (scope) {
      scope.addEventListener('mouseover', function (e) {
        load();
        var link = e.target.closest('[data-follow]');
        // The pointer crosses a 1px row border between two links. A short grace keeps
        // the disc from starting to shrink and regrow on every border.
        if (!link || !scope.contains(link)) {
          clearTimeout(leave);
          leave = setTimeout(off, 80);
          return;
        }
        on(ids.indexOf(link.dataset.follow));
      });
      scope.addEventListener('mouseleave', off);
      scope.addEventListener('mousedown', function (e) {
        if (active && e.target.closest('[data-follow]')) disc.classList.add('pressed');
      });
    });
    addEventListener('mouseup', function () { disc.classList.remove('pressed'); });
  })();
</script>

<style>
  .follow {
    display: none;
  }
  @media (pointer: fine) and (min-width: 60rem) and (prefers-reduced-motion: no-preference) {
    .follow {
      display: contents;
    }
  }
  .follow__frame,
  .follow__disc {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z-preview);
    pointer-events: none;
    overflow: hidden;
    /* The script moves them with translate. Scale and the centring both work from the
       top left corner, so the box stays centred on the pointer at any scale. */
    transform: translate(-50%, -50%);
    transform-origin: 0 0;
    will-change: translate, scale;
    transition: scale 0.3s var(--ease-out);
  }
  /* Kept in its own rule. In the same rule as transform, the minifier folds it into
     transform and the active scale can no longer undo it. */
  .follow__frame:not(.active),
  .follow__disc:not(.active) {
    scale: 0;
  }
  /* Grow with a soft settle and shrink with an ease out, so neither end pops.
     Scale rather than width, so the grow never lays out or repaints the poster. */
  .follow__frame {
    width: clamp(14rem, 30vw, 28rem);
    /* Posters are 16:10 or 16:9, so a 16:10 frame shows them whole or nearly. */
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background: var(--field-deep);
  }
  .follow__frame.active,
  .follow__disc.active {
    transition-timing-function: cubic-bezier(0.34, 1, 0.64, 1);
  }
  .follow__stack {
    height: calc(var(--n) * 100%);
    display: flex;
    flex-direction: column;
    transform: translateY(calc(var(--i, 0) * -100% / var(--n)));
    transition: transform 0.6s var(--ease-out);
  }
  .follow__img {
    flex: 1 1 0;
    min-height: 0;
    width: 100%;
    object-fit: cover;
  }

  .follow__disc {
    --size: clamp(3.75rem, 5.5vw, 5rem);
    width: var(--size);
    height: var(--size);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--field);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .follow--big .follow__disc {
    --size: calc(clamp(3.75rem, 5.5vw, 5rem) * 1.66);
  }
  .follow__disc.pressed {
    scale: 1.4;
    transition: scale 0.3s var(--ease-out);
  }
</style>
